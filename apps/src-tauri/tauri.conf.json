{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "transpic",
  "version": "0.1.0",
  "identifier": "com.axtraz.transpic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "transpic",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "RWSQOPBDnGdPMdTOygWMPLWHi0N2MlhKVFX2aZBZAL5Yqs2w9jVN1vgt"
    }
  }
}